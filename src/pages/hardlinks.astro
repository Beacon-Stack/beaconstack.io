    overflow-wrap: anywhere;
  }

  .table-wrap { overflow-x: auto; }
  .guide-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; line-height: 1.6; }
  .guide-table th, .guide-table td {
    text-align: left; vertical-align: top; padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--color-border); color: var(--color-fg-2);
  }
